# Copy to backend/.env (gitignored) and fill in real values.

# Gmail + Calendar OAuth (shared client, once Step 4's auth refactor lands)
GMAIL_CLIENT_SECRET_PATH=credentials/client_secret.json
GMAIL_TOKEN_PATH=credentials/gmail_token.json

# Step 1 pre-filter aggressiveness — see claude/tradeoffs/pre-filter-aggressiveness.md
FILTER_LEVEL=moderate

# Gemini extraction — key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Gemini requests-per-DAY quota (resets midnight Pacific; there is no monthly
# cap). Drives the usage bar/warning on the dashboard. 20 is an UNCONFIRMED
# third-party-reported figure for the free tier — replace it with the real
# number from the "Rate limit" page in Google AI Studio.
GEMINI_DAILY_QUOTA=20

# Postgres (Neon/Supabase connection string)
DATABASE_URL=

# Crash-recovery claim timeout (minutes)
STALE_CLAIM_MINUTES=15

# IANA timezone for Calendar events (e.g. America/Los_Angeles). Required —
# don't leave blank once deployed off your own machine: it'll silently
# auto-detect from /etc/localtime, which is only correct while this runs
# on your own computer. Set explicitly for whatever Step 8 deployment
# target you land on.
CALENDAR_TIMEZONE=
