# Copy to backend/.env (gitignored) and fill in real values.
# Every setting app/config.py reads is listed here with its default; a test
# (tests/test_env_example.py) fails if this file and config.py drift apart.
# Only the blank ones (and CALENDAR_TIMEZONE) need real values.

# --- Gmail + Calendar OAuth (one shared client/consent) ----------------------
GMAIL_CLIENT_SECRET_PATH=credentials/client_secret.json
GMAIL_TOKEN_PATH=credentials/gmail_token.json

# --- Database ------------------------------------------------------------------
# Postgres connection string (Neon/Supabase).
DATABASE_URL=

# --- Gemini extraction ---------------------------------------------------------
# Key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Pacing between calls, to stay under the free tier's 5 requests/minute.
GEMINI_MIN_INTERVAL_SECONDS=13

# Gemini requests-per-DAY quota (resets midnight Pacific; there is no monthly
# cap). Drives the usage bar/warning on the dashboard and the per-day call
# budget. 20 is the free-tier limit for gemini-3.6-flash, confirmed in Google AI
# Studio (Rate limit page) on 2026-09-18 — change it on a paid tier or another
# model. 0 turns the budget guard off.
GEMINI_DAILY_QUOTA=20
# Calls held back from the budget for usage the pipeline can't see (the AI Studio
# playground, another script on the same project).
GEMINI_DAILY_RESERVE=2
# Dashboard shows a warning once usage crosses this % of GEMINI_DAILY_QUOTA.
LLM_USAGE_WARNING_THRESHOLD_PCT=80

# --- What each run reads and how it retries ---------------------------------------
# Step 1 pre-filter aggressiveness: loose | moderate | strict
FILTER_LEVEL=moderate
# Only unread mail from this many days back. A resilience margin against gaps in
# execution (GitHub's "hourly" cron really fires every ~3.7h), not run cadence.
FETCH_WINDOW_DAYS=2
# Cap on emails read per run (one Gmail page, no pagination).
MAX_EMAILS_PER_RUN=50
# A "processing" claim older than this many minutes is treated as a crashed
# worker and may be retried.
STALE_CLAIM_MINUTES=3
# A real run exits immediately if another run started within this many minutes
# and hasn't finished (so manual + scheduled runs, or Actions + Lambda, can't
# overlap). Also how long a crashed run's "running" row blocks new runs. Must
# exceed the longest legitimate run (Actions caps a run at 25 minutes).
RUN_LOCK_TTL_MINUTES=30
# An email that keeps failing is retried this many times, then left as "failed".
# Rate-limit (429) errors don't count.
MAX_ATTEMPTS_PER_EMAIL=3

# --- Calendar events ---------------------------------------------------------------
# IANA timezone for Calendar events (e.g. America/Los_Angeles). Required — don't
# leave blank once deployed off your own machine: it silently auto-detects from
# /etc/localtime, which is only correct while this runs on your own computer.
CALENDAR_TIMEZONE=
# Length of a timed event; 0 = a point-in-time marker at the deadline.
EVENT_DURATION_MINUTES=0

# --- Date plausibility (an implausible date goes to "needs review", never auto-rejected)
PLAUSIBLE_MAX_PAST_DAYS=3
PLAUSIBLE_MAX_FUTURE_DAYS=365

# --- Duplicate detection & observability thresholds (untuned placeholders) --------
# Event-name similarity (0-1) at which two extractions count as the same deadline.
DUPLICATE_EVENT_NAME_SIMILARITY_THRESHOLD=0.7
# A run's filter pass rate is flagged if it swings this far (0-1) from the
# trailing average, once it has at least the sample size below.
FILTER_PASS_RATE_ANOMALY_THRESHOLD=0.25
FILTER_ANOMALY_MIN_SAMPLE_SIZE=5
